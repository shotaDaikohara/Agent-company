# Anthropic APIキー（Managed Agentsの利用に必須）。
# 未設定でも `ant auth login` 済みなら自動解決される（claude-api skillのAuthentication参照）。
ANTHROPIC_API_KEY=

# APIサーバーのポート（省略時 3001）
PORT=3001

# Task DB（SQLite）のパス（省略時 app/data/ai-cowork.sqlite）
# DB_PATH=./data/ai-cowork.sqlite

# テストモード（true で有効）。
# ONの場合、Project作成はManaged Agents（Anthropic API）へ一切接続しない。
# 代わりにタスクを1件作成して「実行中」にし、5秒後に自動で「完了」・結果に
# "Test Result" をセットする（LLM呼び出しなしでUI/DB/通知の一連の流れを確認できる）。
# ANTHROPIC_API_KEY未設定・agents:setup未実行でも動作する。
TEST_MODE=false
