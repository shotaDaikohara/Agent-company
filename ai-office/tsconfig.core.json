{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-core",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/domain/**/*.ts", "src/db/**/*.ts", "src/tools/**/*.ts", "src/devServer.ts", "tests/**/*.ts"]
}
