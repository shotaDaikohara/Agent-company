{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "web/src/**/*.tsx",
    "web/src/**/*.d.ts"
  ],
  "exclude": [
    "src/node-shims.d.ts",
    "dist-core",
    "node_modules"
  ]
}
